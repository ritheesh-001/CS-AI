{
  "expo": {
    "name": "CrackSense",
    "slug": "cracksense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cracksense",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CrackSense requires camera access to scan and classify structural cracks.",
        "NSLocationWhenInUseUsageDescription": "CrackSense uses high-accuracy GPS to reverse-geocode civic hazard locations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A73E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A73E8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CrackSense requires camera access to scan and classify structural cracks."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CrackSense uses high-accuracy GPS to reverse-geocode civic hazard locations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
